library(here)
###############################
# Wildfire Smoke - Season-Stacked Ensemble (repeated-measures redesign)
###############################
# Stacks years by day-of-year instead of treating 2018-2025 as one
# continuous series, turning forecasting into interpolation across years
# rather than extrapolation off the end of one long line.
library(here)
library(dplyr)
library(lubridate)
library(tidyr)
library(nlme)
library(splines)
library(mgcv)
library(ggplot2)
set.seed(1006092577)
# Reuses indata, PHU_ZONE, build_zone_panel(), phu_name(), smape(),
# compute_weights(), fit_prophet_zone()/forecast_prophet() from 7f.
# Save/restore the caller's guard flag - forcing it TRUE only makes 7f
# skip its own full run; left TRUE it would also skip this file's.
.wfs_caller_functions_only <- exists(".WFS_SOURCE_FUNCTIONS_ONLY") && .WFS_SOURCE_FUNCTIONS_ONLY
.WFS_SOURCE_FUNCTIONS_ONLY <- TRUE
source(here("3_code", "7f_rolling_ensemble.R"))
