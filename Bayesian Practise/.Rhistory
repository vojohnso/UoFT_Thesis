quantile(psi, c(0.025, 0.5, 0.975))
outcome_fit <- stan_glm(Y_death ~ A + age + sex + race + cat1 + meanbp1 + hrt1 + resp1 + temp1 + wtkilo1,
data = rhc,
family = binomial(link="logit"),
prior = normal(0, 0.25),
prior_intercept = normal(0, 5),
chains = 4,
iter = 1000,
seed = 1006092577)
library(rstanarm)
outcome_fit <- stan_glm(Y_death ~ A + age + sex + race + cat1 + meanbp1 + hrt1 + resp1 + temp1 + wtkilo1,
data = rhc,
family = binomial(link="logit"),
prior = normal(0, 0.25),
prior_intercept = normal(0, 5),
chains = 4,
iter = 1000,
seed = 1006092577)
# Step 3:
rhc_m1 <- rhc_m0 <- rhc
rhc_m1$A <- 1
rhc_m0$A <- 0
m1 <- posterior_epred(outcome_fit, newdata = rhc_m1)
m0 <- posterior_epred(outcome_fit, newdata = rhc_m0)
# Step 4:
M <- nrow(as.matrix(outcome_fit))
N <- nrow(rhc)
psi <- numeric(M)
for (i in 1:M) {
w <- rdirichlet(1, rep(1, N))
psi[i] <- sum(w * (m1[i, ] - m0[i, ]))
}
quantile(psi, c(0.025, 0.5, 0.975))
covars <- c("age","sex","race","cat1","meanbp1","hrt1","resp1","temp1","wtkilo1")
d <- rhc[, c("A","Y_death",covars)]
d <- d[complete.cases(d), ]
# X contains all the covariates in the model
X <- model.matrix(~ A + ., data = d[, c("A", covars)])
Y <- d$Y_death
a_col <- which(colnames(X) == "A")
stan_data <- list(N = nrow(X), P = ncol(X), X = X, Y = Y, a_col = a_col)
fit <- stan(file = "Stan/nonparametric.stan", data = stan_data,
chains = 4, iter = 2000, warmup = 1000, seed = 1006092577,
pars = c("psi"), include = TRUE)
setwd("~/Documents/School/Thesis/Bayesian Practise")
stan_data <- list(N = nrow(X), P = ncol(X), X = X, Y = Y, a_col = a_col)
fit <- stan(file = "Stan/nonparametric.stan", data = stan_data,
chains = 4, iter = 2000, warmup = 1000, seed = 1006092577,
pars = c("psi"), include = TRUE)
stan_data <- list(N = nrow(X), P = ncol(X), X = X, Y = Y, a_col = a_col)
fit <- stan(file = "Stan/nonparametric.stan", data = stan_data,
chains = 4, iter = 2000, warmup = 1000, seed = 1006092577,
pars = c("psi"), include = TRUE)
stan_data <- list(N = nrow(X), P = ncol(X), X = X, Y = Y, a_col = a_col)
fit <- stan(file = "Stan/nonparametric.stan", data = stan_data,
chains = 4, iter = 2000, warmup = 1000, seed = 1006092577,
pars = c("psi"), include = TRUE)
fit_parametric <- fit
print(fit_parametric, pars = c("beta", "p1", "p0", "psi"))
print(fit_parametric, pars = c("psi"))
quantile(psi, c(0.025, 0.5, 0.975))
# Compare to the R version
quantile(psi, c(0.025, 0.5, 0.975))
print(fit_parametric, pars = c("psi"))
